# Dependencies
node_modules/

# Build output
output/
dist/
# Vite production bundle (served by Express from server/static)
server/static/

# Server database
server/trueprice.db

# Per-ticker FMP financial snapshots (generated at runtime; folder kept via .gitkeep)
server/data/fmp-financials/*
!server/data/fmp-financials/.gitkeep
# FMP screener snapshots (3-month TTL on server disk)
server/data/screener/*
!server/data/screener/.gitkeep
# Market universe snapshots (20 min TTL)
server/data/cache/*
!server/data/cache/.gitkeep

# Legacy bulk financial + public screener JSON (replaced by FMP API + server cache)
public/data/sp500_financial_data.json
public/data/tasi_financial_data.json
public/data/screener_us.json
public/data/screener_sa.json

# Environment variables
.env
.env.local
.env.*.local
server/.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite
.vite/

# Cache
.cache/

