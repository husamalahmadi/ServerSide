# Dependencies
node_modules/

# Build output
output/
dist/
# Vite production bundle (served by Express from server/static)
server/static/

# Server database
server/trueprice.db

# Per-ticker FMP financial snapshots (generated at runtime; folder kept via .gitkeep)
server/data/fmp-financials/*
!server/data/fmp-financials/.gitkeep
# FMP screener snapshots (screener_us.json / screener_sa.json, 3-month TTL)
server/data/screener/*
!server/data/screener/.gitkeep

# Environment variables
.env
.env.local
.env.*.local
server/.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite
.vite/

# Cache
.cache/

# Python
__pycache__/
